#Modele a copier vers ~/.dbt/profiles.yml
#Aucun secret ici : la connexion vient des variables d'environnement du .env
observatoire_marches:
  target: dev
  outputs:
    dev:
      type: redshift
      host: "{{ env_var('REDSHIFT_HOST') }}"
      port: "{{ env_var('REDSHIFT_PORT', '5439') | as_number }}"
      dbname: "{{ env_var('REDSHIFT_DATABASE', 'dev') }}"
      user: "{{ env_var('REDSHIFT_USER') }}"
      password: "{{ env_var('REDSHIFT_PASSWORD') }}"
      schema: "{{ env_var('REDSHIFT_SCHEMA', 'marts') }}"
      threads: 4
